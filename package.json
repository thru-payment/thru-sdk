{
  "name": "thru-sdk",
  "private": true,
  "description": "Thru's merchant-facing SDKs.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run verify --workspaces --if-present",
    "pay-sdk:build": "npm --workspace @thru-payment/pay-sdk run build",
    "pay-sdk:verify": "npm --workspace @thru-payment/pay-sdk run verify",
    "x402:build": "npm --workspace @thru-payment/x402 run build",
    "x402:test": "npm --workspace @thru-payment/x402 run test",
    "x402:verify": "npm --workspace @thru-payment/x402 run verify"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
