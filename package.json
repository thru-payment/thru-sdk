{
  "name": "thru-sdk-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "The thru SDK monorepo — small, focused packages aggregated into thru-sdk.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm exec --workspaces -- rimraf dist || true",
    "release": "npm run build && npm publish --workspaces"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
