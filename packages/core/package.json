{
  "name": "@thru/sdk-core",
  "version": "0.2.0",
  "description": "Core HTTP client, auth, errors, types and webhook verification for the thru SDK.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thru-payment/thru-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/thru-payment/thru-sdk#readme",
  "bugs": {
    "url": "https://github.com/thru-payment/thru-sdk/issues"
  }
}
