{
  "name": "@thru-payment/checkout-core",
  "version": "0.1.2",
  "description": "Headless data layer for thru checkout: client, hooks, provider and types. No pre-built UI, no styling dependencies - bring your own components.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run build && npm run typecheck && npm run smoke",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thru-payment/thru-sdk.git",
    "directory": "packages/checkout-core"
  },
  "homepage": "https://github.com/thru-payment/thru-sdk#readme",
  "bugs": {
    "url": "https://github.com/thru-payment/thru-sdk/issues"
  }
}
