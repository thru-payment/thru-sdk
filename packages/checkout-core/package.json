{
  "name": "@thru-payment/checkout-core",
  "version": "0.2.0",
  "description": "Headless data layer for thru checkout: framework-agnostic client and stores, plus React hooks and provider. No pre-built UI, no styling dependencies - bring your own components.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run build && npm run typecheck && npm run test && npm run smoke",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.18",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thru-payment/thru-sdk.git",
    "directory": "packages/checkout-core"
  },
  "homepage": "https://github.com/thru-payment/thru-sdk#readme",
  "bugs": {
    "url": "https://github.com/thru-payment/thru-sdk/issues"
  }
}
